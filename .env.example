# ==========================================================================
# Credenciais do Supabase — copie este arquivo para `.env` e preencha.
# Sem essas variaveis, o scanner local continua funcionando 100% (so nao
# replica para o dashboard online).
#
# Onde pegar:
#   1. Abra o Supabase Dashboard -> seu projeto -> Project Settings -> API
#   2. Project URL        -> SUPABASE_URL
#   3. service_role secret -> SUPABASE_SERVICE_KEY  (NAO use a anon key aqui)
#
# IMPORTANTE: `service_role` ignora Row-Level Security. NUNCA commitar o .env
# nem expor essa chave no frontend. O .gitignore ja cobre .env por padrao.
# ==========================================================================

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
